{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "games",
  "main": "./worker.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}